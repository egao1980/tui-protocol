(in-package #:tui-protocol/widgets/tests)

(defun input (&rest initargs) (apply #'make-instance 'w:text-input initargs))
(defun cursor (input) (multiple-value-list (w:text-input-cursor input)))
(defun repeat (n message) (make-list n :initial-element message))

;;; ------------------------------------------------------------------
;;; Editing

(deftest text-input-typing-and-cursor
  (let ((in (input)))
    (ok (string= "" (w:text-input-value in)))
    (ok (equal '("") (w:text-input-lines in)))
    (ok (equal '(0 0) (cursor in)))
    (feed in "hello")
    (ok (string= "hello" (w:text-input-value in)))
    (ok (equal '(0 5) (cursor in)))
    (feed in (key :arrow-left) (key :arrow-left) "X")
    (ok (string= "helXlo" (w:text-input-value in)))
    (ok (equal '(0 4) (cursor in)))
    (feed in (key :home))
    (ok (equal '(0 0) (cursor in)))
    (feed in (key :end))
    (ok (equal '(0 6) (cursor in)))
    (feed in (key :a :ctrl))
    (ok (equal '(0 0) (cursor in)) "Ctrl+A")
    (feed in (key :e :ctrl))
    (ok (equal '(0 6) (cursor in)) "Ctrl+E")
    (feed in (key :arrow-right))
    (ok (equal '(0 6) (cursor in)) "Right at the end stays")))

(deftest text-input-initial-value
  (let ((in (input :value "ab")))
    (ok (string= "ab" (w:text-input-value in)))
    (ok (equal '(0 2) (cursor in)) "cursor at the end"))
  (let ((in (input)))
    (setf (w:text-input-value in) (format nil "a~C~Cb" #\Return #\Newline))
    (ok (equal '("a" "b") (w:text-input-lines in)))
    (ok (equal '(1 1) (cursor in)))))

(deftest text-input-modified-text-is-not-inserted
  (let ((in (input)))
    (feed in (tui:make-key-message :key :b :text "b" :modifiers '(:alt))
          (tui:make-key-message :key :x :text "x" :modifiers '(:ctrl))
          (tui:make-key-message :key :a :text "A" :modifiers '(:shift)))
    (ok (string= "A" (w:text-input-value in)) "Shift text inserts, Ctrl/Alt text does not")))

(deftest text-input-backspace-delete
  (let ((in (input :value "abc")))
    (feed in (key :arrow-left) (key :backspace))
    (ok (string= "ac" (w:text-input-value in)))
    (ok (equal '(0 1) (cursor in)))
    (feed in (key :delete))
    (ok (string= "a" (w:text-input-value in)))
    (ok (equal '(0 1) (cursor in)))
    (feed in (key :delete))
    (ok (string= "a" (w:text-input-value in)) "Delete at the end: nothing")
    (feed in (key :home) (key :backspace))
    (ok (string= "a" (w:text-input-value in)) "Backspace at the start: nothing")))

(deftest text-input-newlines
  (let ((in (input)))
    (feed in "ab" (key :enter :alt) "cd")
    (ok (string= (format nil "ab~%cd") (w:text-input-value in)))
    (ok (equal '("ab" "cd") (w:text-input-lines in)))
    (ok (equal '(1 2) (cursor in))))
  (dolist (k (list (key :enter :shift) (key :enter :ctrl) (key :j :ctrl)))
    (let ((in (input :value "x")))
      (multiple-value-bind (in events) (feed in k)
        (ok (string= (format nil "x~%") (w:text-input-value in))
            (format nil "~S ~S inserts a newline" (tui:key-message-key k)
                    (tui:key-message-modifiers k)))
        (ok (null events)))))
  (let ((in (input :value "x\\")))
    (multiple-value-bind (in events) (feed in (key :enter))
      (ok (null events) "Enter after a backslash does not submit")
      (ok (string= (format nil "x~%") (w:text-input-value in)) "the backslash becomes a newline")
      (ok (equal '(1 0) (cursor in))))))

(deftest text-input-joins-lines
  (let ((in (input :value (format nil "ab~%cd"))))
    (feed in (key :home) (key :backspace))
    (ok (string= "abcd" (w:text-input-value in)))
    (ok (equal '(0 2) (cursor in))))
  (let ((in (input :value (format nil "ab~%cd"))))
    (feed in (key :arrow-up) (key :end) (key :delete))
    (ok (string= "abcd" (w:text-input-value in)))
    (ok (equal '(0 2) (cursor in)))))

(deftest text-input-left-right-cross-lines
  (let ((in (input :value (format nil "ab~%cd"))))
    (feed in (repeat 3 (key :arrow-left)))
    (ok (equal '(0 2) (cursor in)))
    (feed in (key :arrow-right))
    (ok (equal '(1 0) (cursor in)))))

(deftest text-input-word-motion
  (let ((in (input :value "foo bar_baz  qux")))
    (feed in (key :arrow-left :ctrl))
    (ok (equal '(0 13) (cursor in)))
    (feed in (key :arrow-left :alt))
    (ok (equal '(0 4) (cursor in)) "_ is a word character")
    (feed in (key :b :alt))
    (ok (equal '(0 0) (cursor in)))
    (feed in (key :arrow-right :ctrl))
    (ok (equal '(0 3) (cursor in)) "to the end of the word")
    (feed in (key :arrow-right :alt))
    (ok (equal '(0 11) (cursor in)))
    (feed in (key :f :alt))
    (ok (equal '(0 16) (cursor in))))
  (let ((in (input :value (format nil "ab~%cd"))))
    (feed in (key :home) (key :arrow-left :ctrl))
    (ok (equal '(0 2) (cursor in)) "word left at a line start: previous line end")
    (feed in (key :arrow-right :ctrl))
    (ok (equal '(1 0) (cursor in)) "word right at a line end: next line start")))

(deftest text-input-up-down-columns
  (let ((in (input :value (format nil "abcdef~%xy~%日本語x"))))
    (ok (equal '(2 4) (cursor in)))
    (ok (= 7 (w:text-input-cursor-column in)))
    (feed in (key :arrow-up))
    (ok (equal '(1 2) (cursor in)) "clamped to the shorter line")
    (feed in (key :arrow-up))
    (ok (equal '(0 2) (cursor in)) "no sticky goal column")
    (feed in (key :arrow-down) (key :arrow-down))
    (ok (equal '(2 1) (cursor in)) "display column 2 is after 日"))
  (let ((in (input :value (format nil "abc~%日本"))))
    (feed in (key :arrow-up) (key :end) (key :arrow-down))
    (ok (equal '(1 1) (cursor in)) "column 3 snaps left to the boundary at 2")
    (ok (= 2 (w:text-input-cursor-column in)))))

(deftest text-input-kill-keys
  (let ((in (input :value "say hello world")))
    (feed in (key :w :ctrl))
    (ok (string= "say hello " (w:text-input-value in)))
    (ok (equal '(0 10) (cursor in)))
    (feed in (key :home) (repeat 4 (key :arrow-right)) (key :k :ctrl))
    (ok (string= "say " (w:text-input-value in)))
    (ok (equal '(0 4) (cursor in)))
    (feed in (key :u :ctrl))
    (ok (string= "" (w:text-input-value in)))
    (ok (equal '(0 0) (cursor in))))
  (let ((in (input :value (format nil "ab~%cd"))))
    (feed in (key :arrow-up) (key :end) (key :k :ctrl))
    (ok (string= "abcd" (w:text-input-value in)) "Ctrl+K at a line end joins")))

(deftest text-input-wide-and-combining
  (let ((in (input)))
    (feed in "日本")
    (ok (equal '(0 2) (cursor in)))
    (ok (= 4 (w:text-input-cursor-column in)))
    (feed in (key :arrow-left))
    (ok (= 2 (w:text-input-cursor-column in)))
    (feed in (key :backspace))
    (ok (string= "本" (w:text-input-value in))))
  (let ((in (input :value (u "e" #x301 "x"))))
    (ok (equal '(0 3) (cursor in)))
    (ok (= 2 (w:text-input-cursor-column in)) "a combining mark is 0 wide")
    (feed in (key :arrow-left))
    (ok (equal '(0 2) (cursor in)))
    (feed in (key :arrow-left))
    (ok (equal '(0 0) (cursor in)) "Left skips the whole cluster")
    (feed in (key :arrow-right))
    (ok (equal '(0 2) (cursor in)) "Right skips the whole cluster")
    (feed in (key :backspace))
    (ok (string= "x" (w:text-input-value in)) "Backspace removes base and mark"))
  (let ((in (input :value (u "e" #x301 "x"))))
    (feed in (key :home) (key :delete))
    (ok (string= "x" (w:text-input-value in)) "Delete removes base and mark"))
  (let ((in (input)))
    (feed in "e" (tui:make-key-message :key :unidentified :text (u #x301)))
    (ok (string= (u "e" #x301) (w:text-input-value in)) "a typed mark joins its base")
    (ok (equal '(0 2) (cursor in)))
    (ok (= 1 (w:text-input-cursor-column in)))))

(deftest text-input-paste
  (let ((in (input :value "ab")))
    (feed in (key :arrow-left))
    (multiple-value-bind (in events)
        (feed in (paste (u "x" #\Return #\Newline "y" #\Tab "z" #\Return "w" #x7)))
      (ok (null events) "paste never submits")
      (ok (string= (format nil "ax~%y    z~%wb") (w:text-input-value in))
          "CRLF / CR → LF, Tab → 4 spaces, other controls dropped")
      (ok (equal '(2 1) (cursor in)))))
  (let ((in (input)))
    (w:text-input-insert in (format nil "p~%q"))
    (ok (string= (format nil "p~%q") (w:text-input-value in)))
    (ok (equal '(1 1) (cursor in)))))

(deftest text-input-submit
  (let ((in (input :value (format nil "hi~%there"))))
    (multiple-value-bind (in events) (feed in (key :enter))
      (ok (= 1 (length events)))
      (ok (w:submit-event-p (first events)))
      (ok (string= (format nil "hi~%there") (w:submit-event-text (first events))))
      (ok (string= "" (w:text-input-value in)) "the buffer is cleared")
      (ok (equal '(0 0) (cursor in)))))
  (let ((in (input)))
    (multiple-value-bind (in events) (feed in (key :enter))
      (declare (ignore in))
      (ok (null events) "an empty buffer does not submit"))))

(deftest text-input-edit-and-cancel-events
  (let ((in (input :value "draft")))
    (multiple-value-bind (in events) (feed in (key :g :ctrl))
      (ok (w:edit-event-p (first events)))
      (ok (string= "draft" (w:edit-event-text (first events))))
      (ok (string= "draft" (w:text-input-value in)) "the buffer is kept"))
    (multiple-value-bind (in events) (feed in (key :escape))
      (ok (w:cancel-event-p (first events)))
      (ok (string= "draft" (w:text-input-value in))))))

;;; ------------------------------------------------------------------
;;; History

(deftest text-input-history-browse
  (let ((in (input :history (list "first" "second"))))
    (feed in "dra" (key :arrow-up))
    (ok (string= "second" (w:text-input-value in)))
    (ok (equal '(0 6) (cursor in)) "cursor at the entry's end")
    (feed in (key :arrow-up))
    (ok (string= "first" (w:text-input-value in)))
    (feed in (key :arrow-up))
    (ok (string= "first" (w:text-input-value in)) "the oldest stays")
    (feed in (key :arrow-down))
    (ok (string= "second" (w:text-input-value in)))
    (feed in (key :arrow-down))
    (ok (string= "dra" (w:text-input-value in)) "past the newest: the draft")
    (feed in (key :arrow-down))
    (ok (string= "dra" (w:text-input-value in)))
    (ok (equal '("first" "second") (w:text-input-history in)) "browsing changes no entry")))

(deftest text-input-history-multiline-entry
  (let ((in (input :history (list (format nil "one~%two")))))
    (feed in (key :arrow-up))
    (ok (string= (format nil "one~%two") (w:text-input-value in)))
    (ok (equal '(1 3) (cursor in)))
    (feed in (key :arrow-up))
    (ok (equal '(0 3) (cursor in)) "Up inside the entry moves a line")
    (ok (string= (format nil "one~%two") (w:text-input-value in)))))

(deftest text-input-history-edit-ends-browsing
  (let ((in (input :history (list "a" "b"))))
    (feed in (key :arrow-up) "x")
    (ok (string= "bx" (w:text-input-value in)))
    (feed in (key :arrow-down))
    (ok (string= "bx" (w:text-input-value in)) "not browsing: Down does nothing")
    (feed in (key :arrow-up))
    (ok (string= "b" (w:text-input-value in)))
    (feed in (key :arrow-down))
    (ok (string= "bx" (w:text-input-value in)) "the edited text was the new draft")
    (ok (equal '("a" "b") (w:text-input-history in)))))

(deftest text-input-history-submit
  (let ((in (input :history (list "first"))))
    (feed in "second" (key :enter))
    (ok (equal '("first" "second") (w:text-input-history in)))
    (feed in "second" (key :enter))
    (ok (equal '("first" "second") (w:text-input-history in)) "no repeat of the newest")
    (feed in (key :arrow-up))
    (ok (string= "second" (w:text-input-value in)))
    (feed in (key :enter))
    (ok (string= "" (w:text-input-value in)))
    (feed in (key :arrow-down))
    (ok (string= "" (w:text-input-value in)) "submit ends browsing")))

;;; ------------------------------------------------------------------
;;; Completion

(defparameter *files* '("@src/" "@src/main.lisp" "@README.md"))

(defun file-completer (&optional (files *files*))
  "→ (values function calls): the function and a closure returning the tokens
it was called with."
  (let ((calls '()))
    (values (lambda (token)
              (push token calls)
              (remove-if-not (lambda (f) (and (<= (length token) (length f))
                                              (string= token f :end2 (length token))))
                             files))
            (lambda () (reverse calls)))))

(deftest text-input-completion-trigger
  (multiple-value-bind (fn calls) (file-completer)
    (let ((in (input :completion-function fn)))
      (feed in "see @")
      (ok (equal '("@") (funcall calls)) "called once the token starts with @")
      (ok (w:text-input-completing-p in))
      (ok (equal *files* (w:text-input-completion-candidates in)))
      (ok (= 0 (w:text-input-completion-index in)))
      (feed in "R")
      (ok (equal '("@" "@R") (funcall calls)) "typing refines")
      (ok (equal '("@README.md") (w:text-input-completion-candidates in)))
      (feed in (key :tab))
      (ok (string= "see @README.md" (w:text-input-value in)) "Tab accepts")
      (ok (equal '(0 14) (cursor in)))
      (ok (not (w:text-input-completing-p in)))
      (ok (null (w:text-input-completion-candidates in)))
      (ok (null (w:text-input-completion-index in)))
      (ok (equal '("@" "@R") (funcall calls)) "accepting does not query again"))))

(deftest text-input-completion-navigate-and-enter
  (let ((in (input :completion-function (file-completer))))
    (feed in "@s")
    (ok (equal '("@src/" "@src/main.lisp") (w:text-input-completion-candidates in)))
    (feed in (key :arrow-down))
    (ok (= 1 (w:text-input-completion-index in)))
    (feed in (key :arrow-down))
    (ok (= 0 (w:text-input-completion-index in)) "Down wraps")
    (feed in (key :arrow-up))
    (ok (= 1 (w:text-input-completion-index in)) "Up wraps")
    (multiple-value-bind (in events) (feed in (key :enter))
      (ok (null events) "Enter accepts and does not submit")
      (ok (string= "@src/main.lisp" (w:text-input-value in))))
    (multiple-value-bind (in events) (feed in (key :enter))
      (declare (ignore in))
      (ok (w:submit-event-p (first events)) "the next Enter submits"))))

(deftest text-input-completion-close
  (let ((in (input :completion-function (file-completer))))
    (feed in "@")
    (multiple-value-bind (in events) (feed in (key :escape))
      (ok (null events) "Escape first closes the menu")
      (ok (not (w:text-input-completing-p in)))
      (ok (string= "@" (w:text-input-value in))))
    (multiple-value-bind (in events) (feed in (key :escape))
      (declare (ignore in))
      (ok (w:cancel-event-p (first events)))))
  (let ((in (input :completion-function (file-completer))))
    (feed in "@" (key :arrow-left))
    (ok (not (w:text-input-completing-p in)) "Left closes")
    (ok (equal '(0 0) (cursor in)) "and moves")))

(deftest text-input-completion-requery
  (multiple-value-bind (fn calls) (file-completer)
    (let ((in (input :completion-function fn)))
      (feed in "@sx")
      (ok (not (w:text-input-completing-p in)) "no candidates closes")
      (feed in (key :backspace))
      (ok (not (w:text-input-completing-p in)) "a delete does not reopen a closed menu")
      (ok (equal '("@" "@s" "@sx") (funcall calls)))
      (feed in "r")
      (ok (w:text-input-completing-p in) "typed text reopens")
      (ok (equal '("@src/" "@src/main.lisp") (w:text-input-completion-candidates in)))
      (feed in (key :backspace))
      (ok (equal '("@" "@s" "@sx" "@sr" "@s") (funcall calls))
          "a delete re-queries while open"))))

(deftest text-input-completion-only-at-token-start
  (multiple-value-bind (fn calls) (file-completer)
    (let ((in (input :completion-function fn)))
      (feed in "a@b")
      (ok (null (funcall calls)) "the token a@b does not start with @")
      (ok (not (w:text-input-completing-p in))))))

(deftest text-input-completion-tab
  (let ((in (input :completion-function (file-completer '("main.lisp" "make.sh" "notes")))))
    (feed in "open no" (key :tab))
    (ok (string= "open notes" (w:text-input-value in)) "one candidate: accepted at once")
    (ok (not (w:text-input-completing-p in)))
    (feed in " ma" (key :tab))
    (ok (w:text-input-completing-p in) "several: the menu")
    (ok (equal '("main.lisp" "make.sh") (w:text-input-completion-candidates in)))
    (feed in (key :escape) " zz" (key :tab))
    (ok (string= "open notes ma zz" (w:text-input-value in)) "none: nothing")
    (ok (not (w:text-input-completing-p in))))
  (let ((in (input :value "ab")))
    (feed in (key :tab))
    (ok (string= "ab" (w:text-input-value in)) "no completion function: Tab does nothing")))

;;; ------------------------------------------------------------------
;;; View

(deftest text-input-view-basic
  (let* ((in (input :value "hello"))
         (canvas (draw in 12 3)))
    (ok (equal '("> hello" "" "") (tui:canvas-lines canvas)))
    (ok (equal '((7 0)) (inverse-cells canvas)) "the cursor after the text"))
  (let* ((in (input :value (format nil "ab~%cd") :prompt "$ "))
         (canvas (draw in 12 3)))
    (ok (equal '("$ ab" "  cd" "") (tui:canvas-lines canvas)) "other rows start at the prompt width")
    (ok (equal '((4 1)) (inverse-cells canvas))))
  (let* ((in (input :value "hello"))
         (canvas (progn (feed in (key :home)) (draw in 12 3))))
    (ok (equal '((2 0)) (inverse-cells canvas)))
    (ok (string= "h" (tp:cell-text (tui:canvas-cell canvas 2 0))) "the cursor cell keeps its text")))

(deftest text-input-view-wrap
  (let* ((in (input :value "abcdefghij"))
         (canvas (draw in 8 3)))
    (ok (equal '("> abcdef" "  ghij" "") (tui:canvas-lines canvas)))
    (ok (equal '((6 1)) (inverse-cells canvas))))
  (let* ((in (input :value "abcdef"))
         (canvas (draw in 8 3)))
    (ok (equal '("> abcdef" "" "") (tui:canvas-lines canvas)))
    (ok (equal '((2 1)) (inverse-cells canvas)) "a full last row: the cursor on an extra row"))
  (let* ((in (input :value "日本語"))
         (canvas (draw in 7 3)))
    (ok (equal '("> 日本" "  語" "") (tui:canvas-lines canvas)) "a wide char that does not fit wraps")
    (ok (equal '((4 1)) (inverse-cells canvas)))))

(deftest text-input-view-wide-cursor
  (let* ((in (input :value "日本"))
         (canvas (progn (feed in (key :home) (key :arrow-right)) (draw in 10 1))))
    (ok (equal '("> 日本") (tui:canvas-lines canvas)))
    (ok (equal '((4 0) (5 0)) (inverse-cells canvas)) "both cells of the wide char")
    (ok (eq :wide (tp:cell-width (tui:canvas-cell canvas 4 0))))))

(deftest text-input-view-placeholder
  (let* ((in (input :placeholder "Ask anything"))
         (canvas (draw in 20 2)))
    (ok (equal '("> Ask anything" "") (tui:canvas-lines canvas)))
    (ok (tp:style-faint (cell-style canvas 3 0)) "faint")
    (ok (equal '((2 0)) (inverse-cells canvas)) "cursor on its first cell"))
  (let ((in (input :placeholder "Ask anything")))
    (feed in "x")
    (ok (equal '("> x" "") (lines in 20 2)) "gone once there is text")))

(deftest text-input-view-scrolls-to-cursor
  (let ((in (input :value (format nil "1~%2~%3~%4~%5"))))
    (let ((canvas (draw in 6 3)))
      (ok (equal '("  3" "  4" "  5") (tui:canvas-lines canvas)))
      (ok (equal '((3 2)) (inverse-cells canvas))))
    (feed in (repeat 4 (key :arrow-up)))
    (ok (equal '("> 1" "  2" "  3") (lines in 6 3)))
    (feed in (key :arrow-down) (key :arrow-down) (key :arrow-down))
    (ok (equal '("  2" "  3" "  4") (lines in 6 3)) "stateless: cursor on the last row")))

(deftest text-input-view-unfocused
  (let ((in (input :value "abc")))
    (setf (w:widget-focused-p in) nil)
    (ok (null (inverse-cells (draw in 10 1))))))

(deftest text-input-view-completion-menu
  (let ((in (input :completion-function (file-completer))))
    (feed in "see @s")
    (ok (equal '("> see @s" "> @src/" "  @src/main.lisp" "") (lines in 20 4))
        "the menu follows the text rows")
    (feed in (key :arrow-down))
    (ok (equal '("> see @s" "  @src/" "> @src/main.lisp" "") (lines in 20 4))))
  (let ((in (input :completion-function (file-completer '("@a" "@b" "@c" "@d"))
                   :completion-max-items 2)))
    (feed in "@" (key :arrow-down) (key :arrow-down) (key :arrow-down))
    (ok (= 3 (w:text-input-completion-index in)))
    (ok (equal '("> @" "  @c" "> @d" "" "") (lines in 10 5)) "a window of max-items")
    (ok (equal '("  @c" "> @d") (rest (lines in 10 3))) "H - 1 rows at most")
    (ok (equal '("> @" "> @d") (lines in 10 2)))))

;;; ------------------------------------------------------------------
;;; End to end: the emulator's key / paste encoding through the decoder

(deftest text-input-e2e-wide-and-combining
  (let ((in (input)))
    (with-widget-tui (tui program in :cols 12 :rows 2)
      (h:tui-type tui (u "日本e" #x301))
      (ok (screen-is tui (list (u "> 日本e" #x301))))
      (h:tui-stop tui)
      (ok (string= (u "日本e" #x301) (w:text-input-value in)))
      (ok (equal '(0 4) (cursor in)))
      (ok (= 5 (w:text-input-cursor-column in))))))

(deftest text-input-e2e-alt-enter-and-submit
  (let ((in (input)))
    (with-widget-tui (tui program in :cols 12 :rows 3)
      (h:tui-type tui "ab")
      (h:tui-press tui :enter :modifiers '(:alt))
      (h:tui-type tui "cd")
      (ok (screen-is tui '("> ab" "  cd")))
      (ok (null (w:widget-program-events program)))
      (h:tui-press tui :enter)
      (ok (events-reach program 1))
      (ok (string= (format nil "ab~%cd")
                   (w:submit-event-text (first (w:widget-program-events program)))))
      (ok (screen-is tui '(">"))))))

(deftest text-input-e2e-paste
  (let ((in (input)))
    (with-widget-tui (tui program in :cols 12 :rows 3)
      (h:tui-paste tui (format nil "one~%two"))
      (ok (screen-is tui '("> one" "  two")))
      (ok (null (w:widget-program-events program)) "a pasted newline does not submit"))))

(deftest text-input-e2e-history-and-words
  (let ((in (input :history '("old"))))
    (with-widget-tui (tui program in :cols 16 :rows 2)
      (h:tui-press tui :arrow-up)
      (ok (screen-is tui '("> old")))
      (h:tui-type tui " foo bar")
      (h:tui-press tui :arrow-left :modifiers '(:ctrl))
      (h:tui-type tui "X")
      (ok (screen-is tui '("> old foo Xbar"))))))

(deftest text-input-e2e-completion
  (let ((in (input :completion-function (file-completer))))
    (with-widget-tui (tui program in :cols 20 :rows 4)
      (h:tui-type tui "@s")
      (ok (screen-is tui '("> @s" "> @src/" "  @src/main.lisp")))
      (h:tui-press tui :arrow-down)
      (h:tui-press tui :tab)
      (ok (screen-is tui '("> @src/main.lisp")))
      (ok (null (w:widget-program-events program))))))
