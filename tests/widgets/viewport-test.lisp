(in-package #:tui-protocol/widgets/tests)

(defun numbered (n &optional (prefix "l"))
  (loop for i from 1 to n collect (format nil "~A~D" prefix i)))

(defun viewport (&rest initargs) (apply #'make-instance 'w:viewport initargs))

(defun line-strings (vp) (mapcar #'w:runs-string (w:viewport-lines vp)))

(defun wheel (button) (tui:make-mouse-message :button button :action :press :x 1 :y 1))

(deftest viewport-lines-and-counts
  (let ((vp (viewport :lines (list (format nil "a~%b") "c") :width 10 :height 3)))
    (ok (equal '("a" "b" "c") (line-strings vp)) "strings split at newlines")
    (ok (every (lambda (line) (every #'w:text-run-p line)) (w:viewport-lines vp)))
    (ok (= 3 (w:viewport-row-count vp)))
    (ok (= 0 (w:viewport-max-offset vp)))
    (ok (w:viewport-at-bottom-p vp)))
  (let ((vp (viewport :lines (numbered 6) :width 10 :height 3)))
    (ok (= 0 (w:viewport-offset vp)))
    (ok (not (w:viewport-follow-p vp)))
    (ok (= 3 (w:viewport-max-offset vp)))
    (ok (not (w:viewport-at-bottom-p vp)))
    (setf (w:viewport-offset vp) 99)
    (ok (= 3 (w:viewport-offset vp)) "setf offset clamps")
    (ok (not (w:viewport-follow-p vp)) "setf offset leaves follow alone")
    (setf (w:viewport-offset vp) -5)
    (ok (= 0 (w:viewport-offset vp)))))

(deftest viewport-scroll-keys
  (let ((vp (viewport :lines (numbered 6) :width 10 :height 3)))
    (feed vp (key :arrow-down))
    (ok (= 1 (w:viewport-offset vp)))
    (ok (equal '("l2" "l3" "l4") (lines vp 10 3)))
    (feed vp (key :page-down))
    (ok (= 3 (w:viewport-offset vp)) "clamped at the bottom")
    (ok (w:viewport-follow-p vp) "landing at the bottom follows")
    (feed vp (key :arrow-up))
    (ok (= 2 (w:viewport-offset vp)))
    (ok (not (w:viewport-follow-p vp)) "leaving the bottom stops following")
    (feed vp (key :home))
    (ok (= 0 (w:viewport-offset vp)))
    (feed vp (key :end))
    (ok (= 3 (w:viewport-offset vp)))
    (ok (w:viewport-follow-p vp))
    (feed vp (key :page-up))
    (ok (= 0 (w:viewport-offset vp)) "a page is the height")
    (ok (equal '("l1" "l2" "l3") (lines vp 10 3)))))

(deftest viewport-mouse-wheel
  (let ((vp (viewport :lines (numbered 10) :width 10 :height 3)))
    (feed vp (wheel :wheel-down))
    (ok (= 3 (w:viewport-offset vp)))
    (feed vp (wheel :wheel-down) (wheel :wheel-down))
    (ok (= 7 (w:viewport-offset vp)))
    (ok (w:viewport-follow-p vp))
    (feed vp (wheel :wheel-up))
    (ok (= 4 (w:viewport-offset vp)))
    (ok (not (w:viewport-follow-p vp)))))

(deftest viewport-wrap
  (let ((vp (viewport :lines '("hello brave new world" "x") :width 10 :height 4)))
    (ok (= 4 (w:viewport-row-count vp)))
    (ok (equal '("hello" "brave new" "world" "x") (lines vp 10 4))))
  (let ((vp (viewport :lines '("hello brave new world" "x") :wrap nil :width 10 :height 4)))
    (ok (= 2 (w:viewport-row-count vp)))
    (ok (equal '("hello brav" "x" "" "") (lines vp 10 4)) "no wrap: clipped")))

(deftest viewport-follow-tail
  (let ((vp (viewport :follow t :width 10 :height 3)))
    (apply #'w:viewport-append vp (numbered 5))
    (ok (= 2 (w:viewport-offset vp)))
    (ok (equal '("l3" "l4" "l5") (lines vp 10 3)))
    (w:viewport-append vp "l6")
    (ok (= 3 (w:viewport-offset vp)))
    (feed vp (key :arrow-up))
    (ok (not (w:viewport-follow-p vp)))
    (w:viewport-append vp "l7")
    (ok (= 2 (w:viewport-offset vp)) "not following: the view stays put")
    (ok (equal '("l3" "l4" "l5") (lines vp 10 3)))
    (feed vp (key :end))
    (ok (= 4 (w:viewport-offset vp)))
    (w:viewport-append vp (format nil "l8~%l9"))
    (ok (= 6 (w:viewport-offset vp)))
    (ok (equal '("l7" "l8" "l9") (lines vp 10 3)))))

(deftest viewport-follow-on-resize
  (let ((vp (viewport :follow t :lines '("aaaa bbbb cccc dddd") :width 10 :height 2)))
    (ok (equal '("aaaa bbbb" "cccc dddd") (lines vp 10 2)))
    (ok (= 0 (w:viewport-offset vp)))
    (ok (equal '("cccc" "dddd") (lines vp 5 2)) "narrower: more rows, still at the tail")
    (ok (= 2 (w:viewport-offset vp))))
  (let ((vp (viewport :lines (numbered 6) :width 10 :height 3)))
    (feed vp (key :end))
    (setf (w:viewport-follow-p vp) nil)
    (setf (w:viewport-lines vp) (numbered 2))
    (ok (= 0 (w:viewport-offset vp)) "fewer lines: the offset is clamped")
    (ok (equal '("l1" "l2") (line-strings vp)))))

(deftest viewport-streaming-text
  (let ((vp (viewport :follow t :width 20 :height 2)))
    (w:viewport-append-text vp "Hel")
    (ok (equal '("Hel") (line-strings vp)) "the first text makes a line")
    (w:viewport-append-text vp (format nil "lo~%Wor"))
    (w:viewport-append-text vp "ld")
    (ok (equal '("Hello" "World") (line-strings vp)))
    (ok (equal '("Hello" "World") (lines vp 20 2)))
    (w:viewport-append-text vp (format nil "~%!"))
    (ok (equal '("World" "!") (lines vp 20 2)) "following the stream")
    (w:viewport-append-text vp "?" :style (tp:make-style :bold t))
    (let ((last-run (car (last (car (last (w:viewport-lines vp)))))))
      (ok (string= "?" (w:text-run-text last-run)))
      (ok (tp:style-bold (w:text-run-style last-run))))
    (ok (equal '("Hello" "World" "!?") (line-strings vp)))))

(deftest viewport-styled-lines
  (let* ((vp (viewport :lines (list (list (w:text-run "err" :bold t) (w:text-run " ok")))))
         (canvas (draw vp 10 1)))
    (ok (equal '("err ok") (tui:canvas-lines canvas)))
    (ok (tp:style-bold (cell-style canvas 0 0)))
    (ok (not (tp:style-bold (cell-style canvas 4 0))))))

(deftest viewport-e2e-paging
  (let ((vp (viewport :lines (numbered 6))))
    (with-widget-tui (tui program vp :cols 10 :rows 3)
      (ok (screen-is tui '("l1" "l2" "l3")))
      (h:tui-press tui :page-down)
      (ok (screen-is tui '("l4" "l5" "l6")) "the height came from the canvas")
      (h:tui-press tui :arrow-up)
      (ok (screen-is tui '("l3" "l4" "l5")))
      (h:tui-press tui :home)
      (ok (screen-is tui '("l1" "l2" "l3"))))))
